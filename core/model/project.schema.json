{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/angelrivas2025/CADBIMElectri-/core/model/project.schema.json",
  "title": "Proyecto eléctrico CADBIMElectri",
  "type": "object",
  "required": ["schemaVersion", "project", "levels", "rooms", "points", "circuits", "panels"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "type": "string", "pattern": "^\\d+\\.\\d+$" },
    "project": {
      "type": "object",
      "required": ["name", "norm", "voltage", "system"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "norm": { "type": "string", "enum": ["NBR5410"] },
        "voltage": { "type": "number", "exclusiveMinimum": 0, "description": "Tensión fase-neutro en V" },
        "system": { "type": "string", "enum": ["monofasico", "bifasico", "trifasico"] },
        "location": { "type": "string" },
        "supply": {
          "type": "object",
          "description": "Datos para evaluar DPS (NBR 5410 5.4.2.1)",
          "additionalProperties": false,
          "properties": {
            "type": { "type": "string", "enum": ["aerea", "subterranea"] },
            "thunderstorm_days": { "type": "number", "minimum": 0, "description": "Días de tormenta al año" },
            "exposed_parts": { "type": "boolean", "description": "Partes de la instalación expuestas (AQ3)" },
            "has_lightning_rod": { "type": "boolean" },
            "sensitive_equipment": { "type": "boolean" },
            "icc_ka": { "type": "number", "exclusiveMinimum": 0, "description": "Corriente de cortocircuito presumida" },
            "feeder_length_m": { "type": "number", "exclusiveMinimum": 0, "description": "Longitud del alimentador desde el punto de entrega" },
            "feeder_method": { "type": "string", "enum": ["A1", "A2", "B1", "B2", "C", "D", "E", "F", "G"], "description": "Método de instalación del alimentador (tabla 33)" }
          }
        }
      }
    },
    "levels": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "elevation"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "elevation": { "type": "number", "description": "Cota en m" }
        }
      }
    },
    "rooms": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "level", "name", "type", "polygon"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "level": { "type": "string" },
          "name": { "type": "string" },
          "type": { "type": "string", "enum": ["sala", "dormitorio", "cocina", "bano", "servicio", "garaje", "externo", "otro"] },
          "polygon": {
            "type": "array",
            "minItems": 3,
            "description": "Vértices [x, y] en metros",
            "items": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 }
          }
        }
      }
    },
    "points": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "room", "position", "power"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "type": { "type": "string", "enum": ["luminaria", "interruptor", "tug", "tue", "tablero"] },
          "room": { "type": "string" },
          "position": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 },
          "height": { "type": "number", "description": "Altura de montaje en m" },
          "power": { "type": "number", "minimum": 0, "description": "Potencia en VA" },
          "circuit": { "type": ["string", "null"] },
          "feeds_outdoor": {
            "type": "boolean",
            "description": "Toma interior que puede alimentar equipos en el exterior (exige DR 30 mA)"
          }
        }
      }
    },
    "circuits": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "type", "panel"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "type": { "type": "string", "enum": ["iluminacion", "tug", "tue"] },
          "panel": { "type": "string" },
          "phase": { "type": "string", "enum": ["A", "B", "C", "AB", "BC", "AC", "ABC"] },
          "method": {
            "type": "string",
            "enum": ["A1", "A2", "B1", "B2", "C", "D", "E", "F", "G"],
            "description": "Método de referencia de instalación (NBR 5410 tabla 33)"
          },
          "method_variant": {
            "type": "string",
            "enum": ["F_JUSTAPOSTO", "F_TRIFOLIO", "G_HORIZONTAL", "G_VERTICAL"],
            "description": "Variante obligatoria para los métodos F y G"
          },
          "length_m": { "type": "number", "exclusiveMinimum": 0, "description": "Longitud de ida del tramo" },
          "n_loaded": { "type": "integer", "enum": [2, 3], "description": "Conductores cargados" },
          "material": { "type": "string", "enum": ["Cu", "Al"] },
          "insulation": { "type": "string", "enum": ["PVC", "XLPE"] }
        }
      }
    },
    "panels": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "level"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "level": { "type": "string" }
        }
      }
    },
    "routes": { "type": "array", "items": { "type": "object" } },
    "calc": { "type": "object", "description": "Resultados del motor de cálculo (se rellenan en Fase 2)" },
    "history": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["timestamp", "author", "action"],
        "properties": {
          "timestamp": { "type": "string" },
          "author": { "type": "string", "enum": ["usuario", "ia"] },
          "action": { "type": "string" }
        }
      }
    }
  }
}
